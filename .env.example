# Maintenance mode — set to "true" to activate, then restart the Node.js process
MAINTENANCE_MODE=false

NEXT_PUBLIC_BASE_URL=

# HubSpot
HUBSPOT_ACCESS_TOKEN=
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
HUBSPOT_NEWSLETTER_FORM_ID=
HUBSPOT_CONTACT_FORM_ID=

# Analytics
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=
NEXT_PUBLIC_GOOGLE_ANALYTICS=
NEXT_PUBLIC_FACEBOOK_APP_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Cloudflare Turnstile CAPTCHA
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Neon Postgres — read-only SEO/GEO data written by HQ (hq.paperhouse.agency)
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Shared bearer secret HQ uses for POST /api/revalidate and GET /api/routes.
# Must match the value configured in HQ.
REVALIDATE_SECRET=
